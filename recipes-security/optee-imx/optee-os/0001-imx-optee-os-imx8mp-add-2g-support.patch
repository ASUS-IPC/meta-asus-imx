From: singhome1_lee <singhome1_lee@asus.com>
Date: Tue, 19 Mar 2024 13:31:13 +0800
Subject: [PATCH] imx-optee-os: imx8mp: add 2g support

---
 core/arch/arm/plat-imx/conf.mk | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)
 mode change 100644 => 100755 core/arch/arm/plat-imx/conf.mk

diff --git a/core/arch/arm/plat-imx/conf.mk b/core/arch/arm/plat-imx/conf.mk
old mode 100644
new mode 100755
index 433313a92..750c613b7
--- a/core/arch/arm/plat-imx/conf.mk
+++ b/core/arch/arm/plat-imx/conf.mk
@@ -396,10 +396,8 @@ CFG_UART_BASE ?= UART2_BASE
 endif
 
 ifneq (,$(filter $(PLATFORM_FLAVOR),mx8mpevk))
-CFG_DDR_SIZE ?= UL(0x180000000)
+CFG_DDR_SIZE ?=  0x80000000
 CFG_UART_BASE ?= UART2_BASE
-$(call force,CFG_CORE_LARGE_PHYS_ADDR,y)
-$(call force,CFG_CORE_ARM64_PA_BITS,36)
 endif
 
 ifneq (,$(filter $(PLATFORM_FLAVOR),mx8mp_rsb3720_6g))
