/var/log/syslog
{
	rotate 6
       daily
	maxsize 50M
	missingok
	notifempty
	delaycompress
	compress
}

/var/log/mail.info
/var/log/mail.warn
/var/log/mail.err
/var/log/mail.log
/var/log/daemon.log
/var/log/kern.log
{
	rotate 6
       daily
	maxsize 50M
	missingok
	notifempty
	delaycompress
	compress
}
/var/log/auth.log
/var/log/user.log
/var/log/lpr.log
/var/log/cron.log
/var/log/debug
/var/log/messages
{
	rotate 4
       daily
	maxsize 50M
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
}
